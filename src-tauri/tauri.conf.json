{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMW Library",
  "version": "0.1.0",
  "identifier": "com.tmw.epublibrary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "TMW Library", "width": 1100, "height": 720, "minWidth": 800, "minHeight": 600 }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
